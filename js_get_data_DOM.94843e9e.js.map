'use strict';
document.addEventListener('DOMContentLoaded', function() {
    var nodes = Array.from(document.querySelectorAll('.population'));
    var numbers = nodes.map(function(n) {
        return n.textContent.replace(/[^\d]/g, '').trim();
    }).map(function(v) {
        return Number(v);
    }).filter(function(n) {
        return Number.isFinite(n);
    });
    if (!numbers.length) return;
    var total = numbers.reduce(function(sum, n) {
        return sum + n;
    }, 0);
    var average = Math.round(total / numbers.length);
    var fmt = function(n) {
        return n.toLocaleString('en-US');
    };
    var totalE1 = document.querySelector('.total-population');
    var avgE1 = document.querySelector('.average-population');
